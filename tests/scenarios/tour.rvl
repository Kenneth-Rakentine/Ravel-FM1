# A first tour: play the synth, look at every page, catch the tape and let the grains play.
wait 400
shot 01_home.png
wav tour.wav
# a chord on T1, held
key 7 down
key 11 down
key 14 down
wait 900
shot 02_home_playing.png
tap EDIT
wait 200
shot 03_voice_source.png
turn K1 40
turn SELECT 1
wait 150
shot 04_voice_filter.png
turn K1 -20
turn K3 10
turn SELECT 1
wait 150
shot 05_voice_artic.png
key 7 up
key 11 up
key 14 up
wait 300
shot 06_voice_artic_release.png
# the tape: play a phrase into it, then catch it
tap ARP
tapkey 2
tapkey 9
tapkey 14
tapkey 21
tapkey 17
tapkey 12
wait 600
shot 07_tape_listening.png
tap REC
wait 200
expect param CATCH 1
turn SELECT 1
turn K1 20
turn K2 30
wait 2000
shot 08_tape_caught_cloud.png
turn SELECT -1
turn K4 12
wait 1500
shot 09_tape_grains_up.png
tap GLO
wait 300
shot 10_mixer.png
wavstop
expect peak_db_min -30
# save, start again, and the sound is still there
tap SAVE
reboot
wait 300
expect param PITCH 12
expect param CATCH 0
shot 11_after_reboot.png
